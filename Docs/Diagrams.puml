@startuml ThuBa_Architecture
!theme plain
skinparam componentStyle rectangle

title Thứ Ba - Kiến trúc điều khiển nhân vật và camera

package "Player" {
  [Player Input\n(PlayerControls.inputactions)] as Input
  [PlayerController] as Controller
  [CharacterController\nStep Offset 0.3 · Slope Limit 45] as CC
  [CameraTarget\n(y = 1.55)] as Target
}

package "Canvas (cảm ứng)" {
  [On-Screen Stick\n<Gamepad>/leftStick] as Stick
  [On-Screen Button\n<Gamepad>/buttonSouth] as JumpBtn
  [Vùng kéo On-Screen Stick\n<Gamepad>/rightStick] as LookArea
}

package "Camera" {
  [Main Camera\nCinemachine Brain] as Brain
  [CinemachineCamera\nOrbital Follow 5.2 m · FOV 60] as VCam
  [CameraOrbitInput] as OrbitInput
  [CameraModeSwitcher\n(T: đổi Priority)] as Mode
  [CM First Person\ntầm mắt, ẩn model] as FPS
  [CM Top Down\n+14 m cao · −5 m sau · 70°] as Top
  [Cinemachine Deoccluder\nlayer Environment, radius 0.2] as Deocc
}

Stick ..> Input : Move
JumpBtn ..> Input : Jump
LookArea ..> Input : Look
Input --> Controller : Move, Jump, Walk
Input --> OrbitInput : Look
OrbitInput --> VCam : xoay trục ngang / dọc
VCam --> Target : Tracking Target
VCam --> Deocc
Brain --> VCam : chọn camera đang live
Input --> Mode : ToggleCamera (T)
Mode --> VCam : Priority 20 / 0
Mode --> FPS : đặt vị trí mắt
Mode --> Top : đặt vị trí trên cao
Brain --> FPS : blend 0.5 s
Brain --> Top : blend 0.5 s
Brain ..> Controller : forward / right của camera\n(bỏ y, chuẩn hoá)
Controller --> CC : Move((dir * speed + up * velocityY) * dt)\nđúng 1 lần mỗi khung hình

note right of Controller
  * dir = f * input.y + r * input.x
  * speed: chạy 5 m/s, giữ Ctrl đi 2 m/s
  * gravity -20; chạm đất giữ velocityY = -2
  * Nhảy chỉ khi isGrounded: v = sqrt(1.2 * -2 * gravity)
  * Xoay về hướng đi 720°/s
  * Công bố: InputMagnitude, HorizontalSpeed,
    VelocityY, IsGrounded, JumpPressed
end note
@enduml

@startuml ThuNam_FSM_States
!theme plain
hide empty description

title Thứ Năm - State Machine (IState: Enter / Tick / Exit)

[*] --> Idle : Khởi tạo / R

state Idle : Enter: SetFloat("Speed", 0)
state Move : Speed do AnimatorBridge cập nhật
state Jump : Enter: SetTrigger("Jump")
state Fall : Enter: SetBool("IsGrounded", false)

Idle --> Move : có đầu vào
Move --> Idle : hết đầu vào
Idle --> Jump : nhấn nhảy khi chạm đất
Move --> Jump : nhấn nhảy khi chạm đất
Idle --> Fall : !IsGrounded
Move --> Fall : !IsGrounded
Jump --> Fall : VelocityY <= 0
Fall --> Idle : IsGrounded, không có đầu vào
Fall --> Move : IsGrounded, còn đầu vào

state "Mở rộng (không sửa 4 state gốc)" as Ext {
  state Crouch : giữ C · 1.6 m/s · cấm nhảy\nkhông đứng dậy khi có trần
  state Attack : chuột trái · Enter: SetTrigger("Attack")\nhitbox do Animation Event
}

Idle --> Crouch : Crouched
Move --> Crouch : Crouched
Crouch --> Idle : hết khom, không đầu vào
Crouch --> Move : hết khom, còn đầu vào
Crouch --> Fall : !IsGrounded
Idle --> Attack : bắt đầu đòn đánh
Move --> Attack : bắt đầu đòn đánh
Crouch --> Attack : bắt đầu đòn đánh
Attack --> Idle : đòn kết thúc
Attack --> Move : đòn kết thúc, còn đầu vào
Attack --> Jump : nhảy
Attack --> Fall : !IsGrounded

note bottom of Ext
  PlayerStateMachine áp luật chuyển chung trước khi gọi Tick(),
  nên thêm state mới không phải sửa Idle/Move/Jump/Fall.
end note
@enduml

@startuml ThuNam_Update_Order
!theme plain

title Thứ Năm - Thứ tự cập nhật mỗi khung hình (Script Execution Order)

participant "PlayerController\n(order 0)" as PC
participant "PlayerStateMachine\n(order 10)" as SM
participant "AnimatorBridge\n(order 20)" as AB
participant "Animator" as AN
participant "DebugHUD\n(order 30)" as HUD

PC -> PC : đọc Input, tính vận tốc,\nCharacterController.Move
PC -> PC : cập nhật IsGrounded, VelocityY,\nHorizontalSpeed, Jumped
SM -> PC : đọc dữ liệu vừa cập nhật
SM -> SM : luật mở rộng (Attack / Crouch)\nrồi Current.Tick()
SM -> AN : SetTrigger("Jump" / "Attack"),\nSetBool("IsGrounded", false) khi vào Fall
AB -> AN : SetFloat("Speed", 0..1, damp 0.1)\nSetBool("IsGrounded"), SetBool("Crouch")\nLayer weight Upper Body
HUD -> SM : State
HUD -> PC : Speed, Grounded, VelocityY, Camera
@enduml

@startuml ThuNam_Animator_Controller
!theme plain
hide empty description

title Thứ Năm - Animator Controller (Player.controller, Root Motion tắt)

state "Base Layer" as Base {
  [*] --> Locomotion
  state Locomotion : Blend Tree 1D theo Speed\nIdle 0 · Walk 0.5 · Run 1
  state Jump : clip Jump (không loop)
  state Fall : clip Fall (loop)
  state Crouch : Blend Tree Crouch 0 · CrouchWalk 0.4

  Locomotion --> Jump : Jump (trigger), 0.05 s
  Jump --> Fall : Exit Time 0.7, 0.1 s
  Locomotion --> Fall : IsGrounded = false, 0.1 s
  Fall --> Locomotion : IsGrounded = true, 0.1 s
  Locomotion --> Crouch : Crouch = true
  Crouch --> Locomotion : Crouch = false
  Crouch --> Fall : IsGrounded = false
}

state "Upper Body Action\n(Avatar Mask: thân trên, Override)" as Upper {
  [*] --> Empty
  Empty --> AttackClip : Attack (trigger)
  AttackClip --> Empty : Exit Time 0.95
  state "Attack" as AttackClip : Event OpenHitbox 0.16 s\nEvent CloseHitbox 0.65 s
}

note bottom of Upper
  Weight 0 khi không đánh, AnimatorBridge tăng lên 1 trong lúc đánh
  (layer Humanoid dù state rỗng vẫn ghi đè thân trên).
end note
@enduml
